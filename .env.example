# ---- Firebase（プロジェクトの設定 → マイアプリ → ウェブアプリの構成 からコピー） ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# ★ firebaseapp.com ではなく、Vercel で公開する自分のドメインを入れる（例: team-todo.vercel.app）
#   ローカル開発中は <project-id>.firebaseapp.com でOK
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

# ---- サーバー用（プロジェクトの設定 → サービスアカウント → 新しい秘密鍵を生成） ----
# ダウンロードした JSON の中身を1行でそのまま貼る（または base64 にして貼る）
FIREBASE_SERVICE_ACCOUNT=

# ---- プッシュ通知（`npm run vapid` で生成） ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:nakamotoryoke@gmail.com

# ---- 毎朝の通知 cron を保護（長いランダム文字列） ----
CRON_SECRET=
